---
import { getCollection } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const lessons = await getCollection('grammar')

  return lessons.map((lesson) => ({
    params: {
      level: Array.isArray(lesson.data.level) ? lesson.data.level[0].toLowerCase() : lesson.data.level.toLowerCase(),
      lesson: lesson.id,
    },
    props: {
      lesson,
    },
  }))
}

const { lesson } = Astro.props
const { Content } = await render(lesson)

console.log(lesson)
---

<Layout>
  <main class='max-w-330 mx-auto test py-10'>
    <header>home - level - topic - lesson</header>
    <article class='grid grid-cols-[250px_1fr]'>
      <aside>aside</aside>
      <article>
        <Content />
      </article>
    </article>
  </main>
</Layout>
