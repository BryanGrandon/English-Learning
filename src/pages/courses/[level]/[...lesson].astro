---
import { getCollection } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import { render } from 'astro:content'
import LessonPage from '@features/courses/pages/lesson/LessonPage.astro'
import type { EnglishLevel } from '@shared/constants/english-level'

export async function getStaticPaths() {
  const lessons = await getCollection('grammar')

  return lessons.map((lesson) => ({
    params: {
      level: Array.isArray(lesson.data.level) ? lesson.data.level[0].toLowerCase() : lesson.data.level.toLowerCase(),
      lesson: lesson.id,
    },
    props: {
      lesson,
      level: Array.isArray(lesson.data.level) ? lesson.data.level[0].toLowerCase() : lesson.data.level.toLowerCase(),
    },
  }))
}

const { lesson } = Astro.props
const { Content } = await render(lesson)
const level = lesson.data.level as EnglishLevel
---

<Layout>
  <LessonPage level={level}>
    <article slot='content' class='grid gap-4 p-4'>
      <section class='border-b border-divider pb-5'>
        <h1 class='font-bold tracking-tight'>{lesson.data.title}</h1>
        <p class='text-base text-accent sm:text-lg'>{lesson.data.translation}</p>
      </section>
      <section class='mdx-content'>
        <Content slot='content' />
      </section>
    </article>
  </LessonPage>
</Layout>
