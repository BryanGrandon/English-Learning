---
import Lessons from '@features/courses/components/Lessons'
import LevelPage from '@features/courses/levelPage.astro'
import Layout from '@layouts/Layout.astro'
import { COURSES } from '@config/courses'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  return COURSES.map(({ key, ...data }) => {
    let level = key.toLowerCase()
    return {
      params: { level },
      props: { ...data, key },
    }
  })
}

const data = await getCollection('grammar')

const { title, key, icon } = Astro.props
---

<Layout>
  <LevelPage icon={icon} level={key} title={title} data={data} />
</Layout>
