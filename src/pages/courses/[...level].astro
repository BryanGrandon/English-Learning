---
import Layout from '@layouts/Layout.astro'
import LevelCoursePage from '@features/courses/levelCoursePage.astro'
import { COURSES } from '@config/courses/courses'
import LevelPage from '@features/courses/pages/level/LevelPage.astro'

export async function getStaticPaths() {
  return COURSES.map(({ level: key, ...data }) => {
    let level = key.toLowerCase()
    return {
      params: { level },
      props: { ...data, key },
    }
  })
}

const course = Astro.props
---

<Layout>
  <LevelPage level={course.key} />
  <LevelCoursePage level={course.key} />   <!-- Delete -->
</Layout>
