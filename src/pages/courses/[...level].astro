---
import Lessons from '@features/courses/components/Lessons'
import LevelPage from '@features/courses/levelPage.astro'
import Layout from '@layouts/Layout.astro'
import { COURSES } from '@shared/utilities/config/courses'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  return COURSES.map(({ data }) => {
    let level = data.level.toLowerCase()
    return {
      params: { level },
      props: { ...data },
    }
  })
}

const data = await getCollection('grammar')

const { title, level, icon } = Astro.props
---

<Layout>
  <LevelPage icon={icon} level={level} title={title} data={data} />
</Layout>
