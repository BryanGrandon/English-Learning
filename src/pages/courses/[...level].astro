---
import Layout from '@layouts/Layout.astro'
import LevelCoursePage from '@features/courses/levelCoursePage.astro'
import { COURSES } from '@config/courses.ts'

export async function getStaticPaths() {
  return COURSES.map(({ key, ...data }) => {
    let level = key.toLowerCase()
    return {
      params: { level },
      props: { ...data, key },
    }
  })
}

const course = Astro.props
---

<Layout>
  <LevelCoursePage level={course.key} />
</Layout>
