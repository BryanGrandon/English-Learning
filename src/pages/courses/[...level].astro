---
import Lessons from '@features/courses/components/Lessons'
import Layout from '@layouts/Layout.astro'
import Header from '@shared/components/layout/Header.astro'
import { COURSES } from '@shared/utilities/config/courses'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  return COURSES.map(({ data }) => {
    let level = data.level.toLowerCase()
    return {
      params: { level },
      props: { ...data },
    }
  })
}

const data = await getCollection('grammar')

const { title, description, level } = Astro.props
---

<Layout>
  <Header title={title} description={description} />
  <main class='max-w-330 mx-auto w-full'>
    <article class='w-full test p-4 space-y-4'>
      <h2 class='text-3xl font-semibold'>Grammar</h2>
      <Lessons data={data} level={level} />
    </article>
  </main>
</Layout>
