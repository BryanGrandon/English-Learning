---
import Layout from '../layouts/Layout.astro'
import { LEVELS } from '../features/home/utilities/constants/grammar'
---

<Layout>
  <header>
    <nav class='flex justify-between'>
      <div>Logo</div>
      <ul>
        <li>Home</li>
        <li>Curses</li>
        <li>Vocabulary</li>
      </ul>
      <div>
        <p>dark</p>
        <p>Light</p>
      </div>
    </nav>

    <div>
      <h1>Home</h1>
      <p>description</p>
    </div>
  </header>

  <main>
    <article>
      <h2>Curses</h2>

      <section class='flex flex-col gap-2'>
        {
          Object.entries(LEVELS).map(([level, { icon: Icon, title, color }]) => (
            <a href={''} class='flex border rounded-lg px-4 py-2 gap-4 border-[]' style={{ borderColor: color }}>
              <Icon size={20} color={color} />
              <p>
                {title}
                <span>({level})</span>
              </p>
            </a>
          ))
        }
      </section>
    </article>

    <article>
      <h2>Vocabulary</h2>
      <section>
        <p>Travel</p>
        <p>School</p>
        <p>Work</p>
      </section>
    </article>
  </main>

  <footer>
    <p>nav - links</p>
  </footer>
</Layout>
