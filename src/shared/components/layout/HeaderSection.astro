---
interface Props {
  title: string
  paragraph: string
}

const { title, paragraph } = Astro.props
---

<header class='grid'>
  <section class='flex items-center gap-4'>
    <hr class='flex shrink-0 w-1.5 h-full bg-gradient-primary rounded-full border-0' />
    <div class='grid gap-1'>
      <h2 class='text-2xl font-bold'>{title}</h2>
      <p>{paragraph}</p>
    </div>
  </section>
</header>
