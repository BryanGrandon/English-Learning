---
import { cn } from '@shared/lib/cn'
import { CALLOUT_CONFIG, type CalloutVariant } from './callout.config'

interface Props {
  type: CalloutVariant
  className?: string
  fullWidth?: boolean
  title?: string
}

const { type, className = '', title, fullWidth = false } = Astro.props

const { color, background, label, icon } = CALLOUT_CONFIG[type]
const Icon = icon
const widthContent = fullWidth ? 'w-full' : 'w-fit '
---

<section
  class={cn('flex flex-col gap-4 p-4 border rounded-lg w-fit callout-content', className, widthContent)}
  style={{ borderColor: color, backgroundColor: background }}
>
  <header class='flex items-center gap-4 pb-2 border-b' style={{ borderColor: color }}>
    <div class='flex items-center justify-center size-8 rounded-lg' style={{ backgroundColor: color }}>
      <Icon size={18} color='white' />
    </div>
    <p class='capitalize text-lg'>{title ?? label}</p>
  </header>
  <div class='grid gap-4 w-full overflow-x-auto'>
    <slot />
  </div>
</section>
