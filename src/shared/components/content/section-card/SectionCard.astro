---
import { cn } from '@shared/lib/cn'
import Icon from '@shared/components/icons/Icon'
import type { IconName } from '@shared/components/icons/icon-variation'

interface Props {
  title: string
  icon?: IconName
  className?: string
  withBorder?: boolean
}

const { title, icon, className = '', withBorder = false } = Astro.props
const border = withBorder ? 'section-card--border' : ''
---

<section class={cn('lesson-block flex flex-col gap-4 rounded-xl p-4 section-card', className, border)}>
  <header class='flex items-center gap-3 pb-3'>
    {icon && <Icon name={icon} size={20} className='shrink-0' aria-hidden='true' />}

    <h3 class='font-semibold capitalize'>
      {title}
    </h3>
  </header>

  <div class='grid gap-4'>
    <slot />
  </div>
</section>

<style>
  .section-card--border {
    border: 1px solid gray;

    header {
      border-bottom: 1px solid gray;
    }
  }
</style>
