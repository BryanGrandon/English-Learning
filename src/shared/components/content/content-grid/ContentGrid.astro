---
import { cn } from '@shared/lib/cn'

interface Props {
  columns?: number
  gap?: string
  className?: string
}

const { columns = 2, gap = '1rem', className = '' } = Astro.props

const styleClass = 'content-grid'
---

<article
  class={cn('grid w-full min-w-0', className, styleClass)}
  style={{
    '--columns': columns,
    '--gap': gap,
  }}
>
  <slot />
</article>

<style>
  .content-grid {
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--gap);
  }

  @media (max-width: 700px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .content-grid :global(> *) {
      grid-column: span 1 / span 1;
    }
  }
</style>
