---
import { ArrowRight, BookOpen } from 'lucide-react'
import { cn } from '@shared/lib/cn'
import { HERO_HOME } from './config/hero'
import { HOME_TOPICS } from './config/topics'
import { PLATFORM_FEATURES } from './config/features'
import Courses from './components/Courses'
import Button from '@shared/components/ui/buttons/Button'
import Footer from '@shared/components/layout/Footer.astro'
import HeroLayout from '@shared/components/layout/HeroLayout.astro'
import HeroIllustration from './components/EnglishIllustration'
import HeaderSection from '@shared/components/layout/HeaderSection.astro'
import SectionLayout from '@shared/components/layout/SectionLayout.astro'
---

<main class={cn('bg-background flex flex-col')}>
  <HeroLayout {...HERO_HOME}>
    <div slot='buttons' class='flex flex-col md:flex-row items-center gap-2'>
      <Button text='Start Learning' rightIcon={ArrowRight} ariaLabel='Start learning' primary />
      <Button text='Explore Courses' ariaLabel='Explore courses' leftIcon={BookOpen} />
    </div>
    <HeroIllustration slot='illustration' />
  </HeroLayout>

  <SectionLayout label='Learning'>
    <HeaderSection title='Your Learning Path' paragraph='A structured path to help you reach your goals.' />
    <Courses client:load />
  </SectionLayout>

  <SectionLayout label='Topics' background='bg-surface'>
    <HeaderSection title='Learn by topics' paragraph='Focus on what you want to learn.' />
    <article class='grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4'>
      {
        HOME_TOPICS.map(({ icon: Icon, title, description, url, key }) => (
          <a
            href={url}
            aria-label={`Explore ${title}`}
            class='group flex flex-col justify-between gap-4 rounded-xl border border-divider bg-surface-elevated p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-lg'
          >
            <div class='flex items-center gap-4'>
              <div class='flex size-14 items-center justify-center rounded-xl bg-brand/10 text-brand transition-colors duration-300 group-hover:bg-brand group-hover:text-white'>
                <Icon size={30} />
              </div>
            </div>

            <div class='space-y-2'>
              <h3 class='text-xl font-bold transition-colors group-hover:text-brand'>{title}</h3>
              <p class='text-sm leading-relaxed text-muted-foreground'>{description}</p>
            </div>

            <span class='w-fit font-semibold text-brand'>Explore</span>
          </a>
        ))
      }
    </article>
  </SectionLayout>

  <SectionLayout label='Features'>
    <HeaderSection
      title='Explore Our Platform Features'
      paragraph='Explore the tools designed to make learning English easier and more engaging.'
    />
    <article class='grid grid-cols-[repeat(auto-fit,minmax(350px,1fr))] gap-8'>
      {
        PLATFORM_FEATURES.map(({ title, description, icon: Icon }) => (
          <section class='flex flex-col gap-4'>
            <Icon size={38} className='text-accent' />
            <div class='grid gap-2'>
              <h3 class='font-semibold'>{title}</h3>
              <p>{description}</p>
            </div>
          </section>
        ))
      }
    </article>
  </SectionLayout>
</main>

<Footer background='bg-surface' />
