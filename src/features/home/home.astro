---
import { COURSES } from '@shared/utilities/config/courses'
import Header from '@shared/components/layout/Header.astro'
import CourseCard from './components/CourseCard.astro'
---

<article class='flex flex-col gap-16 max-w-350 mx-auto w-full relative'>
  <Header title='Learning English' description='description' withSearch />

  <main>
    <article class='flex flex-col gap-6 test p-4'>
      <div class='space-y-2'>
        <h2 class='font-bold text-3xl'>Courses</h2>
        <p>Explore our English courses and improve your grammar step by step, from A1 Beginner to C2 Proficient.</p>
      </div>

      <section class='grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4'>
        {COURSES.map((el) => <CourseCard course={el.data} />)}
      </section>
    </article>

    <article>
      <h2>Vocabulary</h2>
      <section>
        <p>Travel</p>
        <p>School</p>
        <p>Work</p>
      </section>
    </article>
  </main>

  <footer>
    <p>nav - links</p>
  </footer>
</article>
