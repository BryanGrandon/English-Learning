---
import { cn } from '@shared/lib/cn'
import type { Course } from '../utilities/types/courses'

interface Props {
  course: Course
}

const {
  course: { url, level, title, icon: Icon, description },
} = Astro.props

const levelColor = `var(--color-level-${level.toLowerCase()})`
---

<a
  href={url}
  class={cn(
    'relative flex flex-col items-center gap-4 overflow-hidden rounded-lg border-2 p-4 hover:scale-102 active:scale-98',
  )}
  style={{ borderColor: levelColor, background: levelColor }}
>
  <span
    class='absolute top-0 right-0 text-xs rounded-bl-lg rounded-tr-lg px-4 py-2 border-l-2 border-b-2'
    style={{ borderColor: levelColor }}
  >
    {level}
  </span>

  <div
    class={cn('icon py-6 w-full flex flex-col items-center border-b-2 rounded-xl bg-white')}
    style={{ color: levelColor, borderColor: levelColor }}
  >
    <Icon size={60} />
  </div>

  <div class='flex flex-col gap-2'>
    <h3 class='text-lg font-semibold'>{title}</h3>
    <p class='text-sm text-text-muted'>{description}</p>
  </div>
</a>
