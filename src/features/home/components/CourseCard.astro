---
import { cn } from '@shared/lib/cn'
import type { Course } from '../utilities/types/courses'

interface Props {
  course: Course
}

const {
  course: { url, level, title, icon: Icon, description },
} = Astro.props

const levelColor = `var(--color-level-${level.toLowerCase()})`
const color = `var(--color-level-${level.toLowerCase()})`
---

<a
  href={url}
  class={cn('relative p-4 rounded-xl border-2', ' hover:scale-102 active:scale-98')}
  style={{ borderColor: color }}
>
  <span class='absolute top-6 right-0 px-4 rounded-l-lg border-2 border-r-0' style={{ borderColor: color }}
    >{level}</span
  >

  <div class='flex align-center justify-center py-8'>
    <Icon size={60} color={levelColor} />
  </div>

  <section class='flex flex-col gap-4'>
    <h3 class='text-lg font-semibold text-center'>{title}</h3>
    <p class='text-sm text-text-muted'>{description}</p>
  </section>
</a>
