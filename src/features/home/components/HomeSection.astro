---
import { cn } from '@shared/lib/cn'
import { getBackgroundForStyle } from '@shared/utilities/level-colors.ts'

interface Props {
  label: string
  className?: string
}

const { className, label } = Astro.props
const labelColor = getBackgroundForStyle({ color: 'var(--color-brand)', percentage: 93 })
---

<article class={cn('px-4 py-12 space-y-6', 'divider', className)}>
  <span class='block font-display font-semibold tracking-wider' style={{ color: labelColor }}>{label}</span>
  <slot />
</article>
