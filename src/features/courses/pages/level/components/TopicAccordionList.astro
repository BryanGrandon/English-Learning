---
import { cn } from '@shared/lib/cn'
import { ChevronDown, ArrowUpRight } from 'lucide-react'
import type { Topic } from '@shared/types/topics.type'

interface Props {
  topics: Topic[]
}

const { topics } = Astro.props
---

<article class='grid gap-2'>
  {topics.map((topic) => (
    <details
      data-topic-accordion
      class={cn(
        'group overflow-hidden rounded-xl border border-divider/60',
        'transition-colors duration-200 shadow bg-background/20',
        'hover:border-divider hover:bg-surface-elevated/40',
        'open:border-divider ',
      )}
    >
      <summary
        class={cn(
          'flex cursor-pointer list-none items-center justify-between gap-4 p-4',
          'transition-colors duration-200',
          'group-open:bg-surface-elevated/40',
          'focus-visible:outline-none focus-visible:ring-2',
          'focus-visible:ring-inset focus-visible:ring-brand',
          '[&::-webkit-details-marker]:hidden',
        )}
      >
        <div class='flex min-w-0 items-center gap-3'>
          <div
            class={cn(
              'grid size-11 shrink-0 place-items-center rounded-xl',
              'bg-accent/10 text-muted transition-colors duration-200',
              'group-open:bg-brand/10 group-open:text-brand',
            )}
          >
            <topic.icon size={22} aria-hidden='true' />
          </div>

          <div class='min-w-0 space-y-1'>
            <h3 class='truncate font-display text-base font-semibold'>{topic.title}</h3>

            <p class='truncate text-sm text-muted'>{topic.description}</p>
          </div>
        </div>

        <ChevronDown
          size={20}
          className={cn(
            'shrink-0 text-muted transition-transform duration-300',
            'group-open:rotate-180 group-open:text-brand',
          )}
          aria-hidden='true'
        />
      </summary>

      <ul class='grid gap-2 border-t border-divider/50 p-3 group-open:bg-surface'>
        {topic.lessons.map((lesson, index) => (
          <li>
            <a
              href={lesson.href}
              class={cn(
                'group/lesson flex items-center justify-between gap-4',
                'rounded-lg border border-divider/40 bg-background/30 px-4 py-3',
                'transition-colors duration-200 shadow',
                'hover:border-brand/30 hover:bg-background',
                'focus-visible:outline-none focus-visible:ring-2',
                'focus-visible:ring-brand focus-visible:ring-inset',
              )}
            >
              <div class='min-w-0 space-y-1'>
                <span class='text-xs font-medium text-muted'>Lesson {String(index + 1).padStart(2, '0')}</span>

                <h4 class='truncate text-sm font-medium text-foreground'>{lesson.title}</h4>

                <p class='truncate text-sm text-muted'>{lesson.translation}</p>
              </div>

              <ArrowUpRight
                size={19}
                className={cn(
                  'shrink-0 text-muted transition-all duration-200',
                  'group-hover/lesson:-translate-y-0.5',
                  'group-hover/lesson:translate-x-0.5',
                  'group-hover/lesson:text-brand',
                )}
                aria-hidden='true'
              />
            </a>
          </li>
        ))}
      </ul>
    </details>
  ))}
</article>
