---
import { cn } from '@shared/lib/cn'
import type { LucideIcon } from 'lucide-react'
import { ChevronDown, MousePointerClick } from 'lucide-react'
import type { GrammarLesson } from '../types/grammar-lesson'

interface Props {
  title: string
  description: string
  lessons: { key: string }[]
  icon: LucideIcon
  data: GrammarLesson[]
}

const { title, description, lessons, icon: Icon, data } = Astro.props

const lessonMap = new Map(data.map((lesson) => [lesson.data.key, lesson]))

const lessonList = lessons.map((lesson) => {
  const lessonData = lessonMap.get(lesson.key)

  return {
    ...lesson,
    title: lessonData?.data.title,
    translation: lessonData?.data.translation,
    href: lessonData ? `/courses/${lessonData.id}` : undefined,
  }
})
---

<details
  data-topic-accordion
  class={cn(
    'group rounded-lg',
    'border-2 border-transparent bg-surface-layout',
    'transition-transform duration-200',
    'open:border-divider',
  )}
>
  <summary
    class={cn(
      'relative flex cursor-pointer list-none items-center justify-between p-4',
      'group-open:border-b-2 group-open:border-divider',
      'group-open:bg-highlight-layout/30',
    )}
  >
    <div class='flex items-center gap-4 px-2'>
      <Icon size={25} className='text-muted' />
      <div>
        <h3 class='text-lg'>{title}</h3>
        <p>{description}</p>
      </div>
    </div>
    <ChevronDown size={25} className='transition-transform duration-200 group-open:rotate-180' />
  </summary>
  <ul class='space-y-2 p-4'>
    {
      lessonList.map((lesson, index) => (
        <li>
          <a
            href={lesson.href}
            class={cn(
              'flex items-center justify-between gap-4 rounded-lg px-4 py-2',
              'bg-highlight-layout/20 hover:bg-highlight-layout/30',
            )}
          >
            <div>
              <span class='text-xs text-muted'>Lesson {index + 1}</span>
              <h3>{lesson.title}</h3>
              <p class='px-2 text-sm'>{lesson.translation}</p>
            </div>
            <MousePointerClick />
          </a>
        </li>
      ))
    }
  </ul>
</details>
