---
import { cn } from '@shared/lib/cn'
import { ChevronDown, ArrowUpRight } from 'lucide-react'
import type { LevelTopic } from '@shared/types/level-topics'

interface Props {
  topics: LevelTopic[]
}

const { topics } = Astro.props
---

<article class='grid gap-2'>
  {topics.map((topic) => (
    <details
      data-topic-accordion
      class={cn(
        'group mr-3 overflow-hidden rounded-r-xl ',
        'border border-transparent border-l-2',
        'transition-all duration-200',
        'hover:border-divider/70 ',
        'open:border-divider/70 open:border-l-brand',
        'open:bg-background/40',
      )}
    >
      <summary
        class={cn(
          'flex cursor-pointer list-none items-center justify-between gap-3',
          'px-3 py-1 transition-colors duration-200',
          'hover:bg-accent/10',
          'focus-visible:outline-none focus-visible:ring-2',
          'focus-visible:ring-inset focus-visible:ring-brand',
          'group-open:bg-accent/10 ',
          '[&::-webkit-details-marker]:hidden',
        )}
      >
        <div class='flex min-w-0 items-center gap-3'>
          <div
            class={cn(
              'grid size-9 shrink-0 place-items-center rounded-lg',
              'bg-accent/10 text-muted transition-all duration-200',
              'group-open:bg-brand/10 group-open:text-brand',
            )}
          >
            <topic.icon size={19} aria-hidden='true' />
          </div>

          <h3
            class={cn(
              'truncate text-sm font-medium text-muted',
              'transition-colors duration-200',
              'group-open:font-semibold group-open:text-foreground',
            )}
          >
            {topic.title}
          </h3>
        </div>

        <ChevronDown
          size={18}
          className={cn(
            'shrink-0 text-muted transition-transform duration-300',
            'group-open:rotate-180 group-open:text-brand',
          )}
          aria-hidden='true'
        />
      </summary>

      <ul class='ml-7 grid gap-1 border-l border-divider/70 pb-3 pt-1 pl-3'>
        {topic.lessons.map((lesson) => (
          <li>
            <a
              href={lesson.href}
              class={cn(
                'group/lesson flex min-w-0 items-center justify-between gap-2',
                'rounded-lg px-3 py-2.5 text-sm text-muted',
                'transition-all duration-200',
                'hover:bg-surface-elevated hover:text-foreground',
                'focus-visible:outline-none focus-visible:ring-2',
                'focus-visible:ring-brand',
              )}
            >
              <span class='min-w-0 truncate'>{lesson.title}</span>

              <ArrowUpRight
                size={16}
                className={cn(
                  'shrink-0 text-muted opacity-0',
                  'transition-all duration-200',
                  'group-hover/lesson:translate-x-0.5',
                  'group-hover/lesson:-translate-y-0.5',
                  'group-hover/lesson:text-brand',
                  'group-hover/lesson:opacity-100',
                )}
                aria-hidden='true'
              />
            </a>
          </li>
        ))}
      </ul>
    </details>
  ))}
</article>
