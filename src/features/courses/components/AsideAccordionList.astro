---
import { cn } from '@shared/lib/cn'
import { ChevronDown, MousePointerClick } from 'lucide-react'
import type { LevelTopic } from '@shared/types/level-topics'

interface Props {
  topics: LevelTopic[]
}

const { topics } = Astro.props
---

<article class='h-full'>
  {
    topics.map((topic) => (
      <details
        data-topic-accordion
        class={cn(
          'border-r-2 rounded-r-2xl bg-surface-layout overflow-hidden border-b-2 border-transparent mr-4',
          'group open:border-highlight-layout/60',
        )}
      >
        <summary
          class={cn(
            'flex cursor-pointer list-none items-center justify-between py-2 pr-2 pl-4',
            'group-open:bg-highlight-layout/60',
          )}
        >
          <div class='flex items-center gap-4'>
            <topic.icon size={20} className='text-muted' />
            <h3 class='text-base'>{topic.title}</h3>
          </div>
          <ChevronDown size={25} className='transition-transform duration-200 group-open:rotate-180' />
        </summary>
        <ul class='space-y-2 px-4 py-3'>
          {topic.lessons.map((lesson) => (
            <li>
              <a
                href={lesson.href}
                class={cn(
                  'flex items-center justify-between gap-4 rounded-lg px-4 py-2 bg-highlight-layout/30',
                  'hover:bg-highlight-layout/30',
                )}
              >
                <h4 class='font-display text-sm'>{lesson.title}</h4>
                <MousePointerClick size={20} />
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</article>
