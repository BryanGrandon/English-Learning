---
import { cn } from '@shared/lib/cn'
import { ArrowLeft, Home } from 'lucide-react'
import { transparentMix } from '@shared/utilities/color/transparentMix'
import type { CourseInformation } from '@config/courses'
import type { LevelTopic } from '@shared/utilities/types/level-topics'

interface Props {
  course: CourseInformation
  topics: LevelTopic[]
}
const { topics, course } = Astro.props
const { title, description, icon: Icon } = course

const url = Astro.url.pathname
const selectedTopic = url.split('/').at(-2) as string
const isLesson = selectedTopic !== 'courses'

const color = `var(--color-level-${course.key.toLowerCase()})`
const background = transparentMix({ color, percentage: 10 })
---

<aside class={cn('p-4', 'level-content__aside')}>
  <article class={cn('rounded-xl border border-divider bg-surface-layout space-y-2')}>
    <a href='/' class='flex p-4 gap-2'> <ArrowLeft size={25} /> Back to Home </a>

    <section class='space-y-2'>
      <section class={cn('px-4 flex items-center gap-4')}>
        <div
          class='flex items-center justify-center rounded-xl border-2 p-3 m-0'
          style={{ backgroundColor: background, borderColor: color }}
        >
          <Icon size={28} />
        </div>
        <div class='flex flex-col text-lg tracking-wide'>
          <span class='text-sm'>{course.key}</span>
          {title}
        </div>
      </section>
      <p class='leading-relaxed text-muted px-4'>{description}</p>
    </section>

    <a class={cn('px-4 py-2 flex gap-2 items-center  mr-4 rounded-r-2xl ', !isLesson ? 'bg-highlight-layout/60' : '')}>
      <Home size={20} /> Overview
    </a>

    <section class={cn('flex flex-col gap-2', '')}>
      <h3 class={cn('text-lg font-semibold px-4 tracking-wide text-muted')}>Lessons</h3>
      <p>Create Componente of the details and summary for Topics and Lessons</p>
      <section class={cn('space-y-3')}>
        {
          topics.map((topic) => (
            <div
              class={cn(
                'flex gap-3 items-center px-4 py-1 text-muted cursor-pointer rounded-r-2xl mr-4',
                'hover:bg-highlight-layout',
                selectedTopic === topic.key ? 'bg-highlight-layout' : '',
              )}
            >
              <topic.icon size={20} className='text-muted' />
              <p>{topic.title}</p>
            </div>
          ))
        }
      </section>
    </section>
  </article>
</aside>
