---
import { cn } from '@shared/lib/cn'
import { COURSES_TOPIC } from '@config/courses'
import { getTopicsWithLessons } from '@shared/lib/grammar'
import type { LevelTopic } from '@shared/types/level-topics'
import { type EnglishLevel } from '@shared/constants/english-level'
import CourseSidebar from './components/CourseSidebar.astro'
import TopicAccordionList from './components/TopicAccordionList.astro'
import Header from './components/Header.astro'

interface Props {
  level: EnglishLevel
}
const { level } = Astro.props

const topics: LevelTopic[] = await getTopicsWithLessons(level)
const course = COURSES_TOPIC.filter((el) => el.key === level)[0]
---

<article class={cn('level-content max-width')}>
  <CourseSidebar course={course} topics={topics} />
  <main class={cn('flex flex-col gap-4  p-4', 'level-content__main')}>
    <Header
      level={course.key}
      title={course.title}
      heading={course.heading}
      description={course.description}
      numberLessons={topics.length}
    />

    <article class={cn('flex justify-between items-center')}>
      <section>
        <span class=''>Lessons</span>
        <h2>{level} Courses Lessons</h2>
        <p>Explore the topic below and complete each lesson at your own pace.</p>
      </section>
      <!-- Search ?? -->
    </article>

    <TopicAccordionList topics={topics} />
  </main>
</article>

<style>
  .level-content {
    display: grid;
    grid-template-columns: 20rem minmax(0, 1fr);
    gap: 1.5rem;
  }

  .level-content__aside {
    grid-column: 1;
  }

  .level-content__main {
    grid-column: 2;
    min-width: 0;
  }

  @media (max-width: 900px) {
    .level-content {
      grid-template-columns: minmax(0, 1fr);
    }

    .level-content :global(.level-content__aside) {
      display: none;
    }

    .level-content__main {
      grid-column: 1;
    }
  }
</style>

<script>
  const accordions = document.querySelectorAll<HTMLDetailsElement>('[data-topic-accordion]')

  accordions.forEach((accordion) => {
    accordion.addEventListener('toggle', () => {
      if (!accordion.open) return

      accordions.forEach((item) => {
        if (item !== accordion) item.open = false
      })

      if (accordion.open) accordion.scrollIntoView({ behavior: 'smooth', block: 'center' })
    })
  })
</script>
