---
import { cn } from '@shared/lib/cn'
import type { LevelTopic } from '@shared/utilities/types/level-topics'
import type { CourseInformation } from '@config/courses'

interface Props {
  course: CourseInformation
  topics: LevelTopic[]
}

const { course, topics } = Astro.props
const url = Astro.url.pathname
const selectedTopic = url.split('/')[2] as string
---

<article class={cn('level-content max-width')}>
  <aside class={cn('test p-4', 'level-content__aside')}>
    <article class={cn('rounded-xl min-h-1/2 bg-gray-900')}>
      <button class={cn('p-4')}> ⬅️ Back to Home </button>

      <section class={cn('flex flex-col gap-2 p-4', 'rounded-xl')}>
        <div>
          <course.icon />
          <p>{course.title}</p>
        </div>
        <p>{course.description}</p>
      </section>

      <button class={cn('px-4 py-2')}> IconHome Overview </button>

      <section class={cn('flex flex-col gap-2 py-4', '')}>
        <h3 class={cn('text-lg font-semibold px-4')}>Lessons</h3>
        <section class={cn('space-y-3')}>
          {
            topics.map((topic) => (
              <div
                class={cn(
                  'flex gap-3 items-center px-4 py-1',
                  'text-muted cursor-pointer',
                  'rounded-r-lg mr-4',
                  'nouns' === topic.key ? 'bg-blue-900/80' : '',
                )}
              >
                <topic.icon size={20} className='text-muted' />
                <p>{topic.title}</p>
              </div>
            ))
          }
        </section>
      </section>
    </article>
  </aside>
  <main class={cn('flex flex-col gap-4 test p-4', 'level-content__main')}>
    <header class={cn('test p-4', 'rounded-2xl')}>
      <h1>{course.title}</h1>
    </header>

    <article class={cn('flex justify-between items-center')}>
      <section>
        <span class=''>Lessons</span>
        <h2>{course.key} Courses Lessons</h2>
        <p>Explore the topic below and complete each lesson at your own pace.</p>
      </section>
      <section class='test'>
        <input type='search' name='' id='' placeholder='Search Lessons...' />
      </section>
    </article>

    <article class={cn('h-full space-y-2')}>
      {
        topics.map((topic) => (
          <section class={cn('test p-4 flex items-center justify-between gap-4', 'rounded-xl')}>
            <section class={cn('flex gap-4 items-center')}>
              <div>
                <topic.icon size={30} />
              </div>
              <div>
                <span>{topic.title}</span>
                <h3>description</h3>
              </div>
            </section>

            <div>
              <span>Status = completed, continues, start </span>
              <button>Start</button>
              <button>Drop ⬇️</button>
            </div>
            <section>
              {topic.lessons.map((lesson) => (
                <div class={cn('flex gap-4 items-center')}>
                  <span>{lesson.title}</span>
                  <h3>description</h3>
                </div>
              ))}
            </section>
          </section>
        ))
      }
    </article>
  </main>
</article>

<style>
  .level-content {
    display: grid;
    grid-template-columns: 20rem 1fr;
    grid-template-areas:
      'aside main'
      'aside main';
  }

  .level-content__aside {
    grid-area: aside;
  }
  .level-content__main {
    grid-area: main;
  }
</style>
