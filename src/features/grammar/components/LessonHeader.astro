---
interface Props {
  title: string
  translation: string
}

const { title, translation } = Astro.props
---

<header class='border-b border-b-gray-600 pb-2'>
  <h1>
    {title}
  </h1>

  <p class='mt-2 text-yellow-500'>
    ({translation})
  </p>
</header>

<style>
  h1 {
    margin-top: 3rem;
    font-size: clamp(2rem, 4vw, 2.8rem);
  }
</style>
